# ---- Kanboard connection -------------------------------------------------------
# Base URL of your Kanboard (".../jsonrpc.php" is added automatically).
# Examples: http://localhost:8080   https://kanboard.example.com   http://kanboard (Docker)
KANBOARD_URL=http://localhost:8080

# Recommended: your Kanboard username + a personal access token
# (Kanboard > My profile > API > Generate a new token).
# Alternative: KANBOARD_USERNAME=jsonrpc with the global token from Settings > API
# (full access to every project; then set KANBOARD_DEFAULT_USER_ID for comments).
KANBOARD_USERNAME=your-username
KANBOARD_API_TOKEN=change-me
# KANBOARD_DEFAULT_USER_ID=1
# KANBOARD_VERIFY_SSL=true        # false for self-signed certificates
# KANBOARD_TIMEOUT=20

# ---- MCP transport -------------------------------------------------------------
# stdio: launched by Claude Code / Claude Desktop on the same machine (default)
# http:  long-running server for remote clients (claude.ai, Claude mobile)
MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# ---- Authentication (http transport only) --------------------------------------
# none:   only allowed when MCP_HOST is loopback
# bearer: shared secret header — good for Claude Code; generate with: openssl rand -hex 32
# github: GitHub OAuth limited to MCP_ALLOWED_GITHUB_USERS — needed for claude.ai / mobile
MCP_AUTH=none
# MCP_BEARER_TOKEN=
# MCP_BASE_URL=https://kanboard-mcp.example.com
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MCP_ALLOWED_GITHUB_USERS=your-github-login
# MCP_JWT_SIGNING_KEY=          # optional; openssl rand -hex 32

# LOG_LEVEL=INFO
